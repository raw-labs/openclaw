{
  "id": "github-repositories",
  "name": "GitHub",
  "description": "GitHub accounts, execution identity, public link previews, and document reader.",
  "enabledByDefault": true,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reader": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/index.js",
    "settingsViews": [
      {
        "id": "connections",
        "section": "profile",
        "panel": "connections",
        "requiredMethods": [
          "tools.github.status"
        ],
        "search": {
          "label": "GitHub connections",
          "hash": "#settings-profile-github-connections",
          "aliases": "github oauth account connection publication authentication auth status dashboard actions"
        }
      },
      {
        "id": "agent-tools",
        "section": "agents",
        "panel": "tools",
        "requiredMethods": [
          "tools.github.status"
        ]
      }
    ]
  },
  "activation": {
    "onStartup": true
  },
  "uiCapabilities": [
    "action",
    "link-reader"
  ],
  "contracts": {
    "tools": [
      "github_read",
      "github_search"
    ],
    "gatewayMethodDispatch": [
      "authenticated-request"
    ]
  },
  "toolMetadata": {
    "github_read": {
      "profiles": [
        "coding"
      ]
    },
    "github_search": {
      "profiles": [
        "coding"
      ]
    }
  },
  "doctorContract": {
    "configRepair": true
  },
  "configContracts": {
    "compatibilityMigrationPaths": [
      "plugins.entries.github",
      "plugins.allow",
      "plugins.deny"
    ]
  },
  "categories": [
    "developer-tools"
  ]
}
